---
import Lockup from './Lockup.astro';
// De homepage en /reviews hebben allebei een contactblok; daar scrolt de
// knop naar beneden. Alleen de 404 heeft er geen, die stuurt naar de homepage.
const contactHref = Astro.url.pathname.startsWith('/404') ? '/#contact' : '#contact';
---

<header>
  <nav class="container">
    <a href="/" class="logo" aria-label="Chief Story, naar de homepage"><Lockup /></a>
    <a href={contactHref} class="cta-nav">Plan een call</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 80px;
  }

  /* Lockup op 36px; op een telefoon kleiner, anders past hij niet naast de knop. */
  .logo {
    font-size: 36px;
    flex-shrink: 0;
  }

  .cta-nav {
    margin-left: auto;
    font-size: 0.875rem;
    font-weight: 400;
    font-family: var(--font-heading);
    background: var(--text);
    color: var(--bg);
    padding: 0.5rem 1.1rem;
    border-radius: 6px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .cta-nav:hover {
    background: var(--wit);
    color: var(--text);
    box-shadow: inset 0 0 0 1.5px var(--text);
  }

  @media (max-width: 768px) {
    nav {
      gap: 1rem;
    }
  }

  @media (max-width: 640px) {
    nav {
      height: 64px;
    }

    .logo {
      font-size: 24px;
    }
  }
</style>
