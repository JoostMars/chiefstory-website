---
---

<header>
  <nav class="container">
    <a href="/" class="logo">Chief Story</a>
    <a href="#contact" class="cta-nav">Plan een call</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .cta-nav {
    margin-left: auto;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: var(--font-heading);
    background: var(--text);
    color: var(--bg);
    padding: 0.5rem 1.1rem;
    border-radius: 6px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  .cta-nav:hover {
    background: var(--accent);
  }

  @media (max-width: 768px) {
    nav {
      gap: 1rem;
    }
  }
</style>
