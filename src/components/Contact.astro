---
// Het contactblok met formulier. Staat onderaan de homepage én onderaan
// /reviews; de copy en de web3forms-sleutel komen uit home.md via `contact`.
interface Props {
  contact: {
    heading: string;
    lead: string;
    email: string;
    web3forms_key: string;
  };
}

const { contact } = Astro.props;
---

<section class="section-contact" id="contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-text">
        <h2>{contact.heading}</h2>
        <p class="lead">{contact.lead}</p>
        <a href={`mailto:${contact.email}`} class="contact-link">{contact.email}</a>
      </div>
      <div class="form-wrapper">
        <form
          id="signal-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          data-terugval-email={contact.email}
        >
          <input type="hidden" name="access_key" value={contact.web3forms_key} />
          <input type="hidden" name="subject" value="Nieuwe call aanvraag" />
          <input type="hidden" name="from_name" value="Chief Story Website" />
          <input type="checkbox" name="botcheck" style="display:none" />

          <div class="form-row">
            <div class="field">
              <label for="naam">Naam</label>
              <input type="text" id="naam" name="naam" required placeholder="John Doe" />
            </div>
            <div class="field">
              <label for="organisatie">Organisatie</label>
              <input type="text" id="organisatie" name="organisatie" required placeholder="My business" />
            </div>
          </div>

          <div class="field">
            <label for="email">E-mailadres</label>
            <input type="email" id="email" name="email" required placeholder="john@example.com" />
          </div>

          <div class="field">
            <label for="ruis">Wat voelt nu als ruis?</label>
            <textarea id="ruis" name="ruis" rows="4" placeholder="Hoe korter hoe beter" required></textarea>
          </div>

          <button type="submit" class="btn-submit">Verstuur aanvraag</button>
          <div id="form-result" class="form-result" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .section-contact {
    padding: 4rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-text h2 {
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    margin-bottom: 1rem;
  }

  .contact-text h2::after {
    content: '';
    display: block;
    width: 88px;
    height: 3px;
    margin-top: 1.5rem;
    background: var(--accent);
  }

  .contact-text .lead {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-link {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 400;
    border-bottom: 1.5px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }

  .contact-link:hover {
    border-color: var(--text);
  }

  .form-wrapper {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 2.5rem;
    border: 1px solid var(--border);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text);
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    transition: border-color 0.15s;
    outline: none;
    resize: vertical;
    width: 100%;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  input:focus,
  textarea:focus {
    border-color: var(--text);
  }

  .btn-submit {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1rem;
    background: var(--text);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.875rem 1.5rem;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
    margin-top: 0.25rem;
  }

  .btn-submit:hover {
    background: var(--color-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1.5px var(--text);
  }

  .form-result {
    margin-top: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .form-result--success { color: #2d6a2d; }
  .form-result--error { color: var(--accent); }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .section-contact {
      padding: 3rem 0;
    }

    .form-wrapper {
      padding: 1.75rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-text .lead {
      font-size: 1.05rem;
    }

    .btn-submit {
      font-size: 1rem;
    }

    /* 16px is ook de ondergrens waaronder iOS Safari bij het aantikken
       van een veld automatisch inzoomt. */
    input,
    textarea {
      font-size: 1rem;
    }

    label {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  const form = document.getElementById('signal-form') as HTMLFormElement;
  const result = document.getElementById('form-result') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Versturen...';

    try {
      const data = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      const json = await res.json();
      if (!json.success) throw new Error(json.message ?? 'onbekende fout');

      form.reset();
      result.textContent = 'Bedankt! Ik neem binnen één werkdag contact op.';
      result.className = 'form-result form-result--success';
    } catch {
      // Netwerkfout, geblokkeerd verzoek of een antwoord dat geen JSON is.
      const adres = form.dataset.terugvalEmail ?? '';
      result.textContent = `Er ging iets mis. Stuur een mail naar ${adres}.`;
      result.className = 'form-result form-result--error';
    } finally {
      // Hoe het ook afloopt: de knop moet weer bruikbaar zijn.
      btn.disabled = false;
      btn.textContent = 'Verstuur aanvraag';
    }
  });
</script>
