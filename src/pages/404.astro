---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

// De copy van deze pagina staat hier en niet in home.md: dat bestand heeft
// een vast schema voor de homepage. Dit is een systeempagina, geen verhaal.
const page = await getEntry('pages', 'home');
const { contact } = page!.data;
---

<BaseLayout title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer).">
  <Nav />

  <main>
    <section class="niet-gevonden">
      <div class="container">
        <p class="code">404</p>
        <h1>Deze pagina bestaat niet.</h1>
        <p class="lead">
          Waarschijnlijk een oude link, of een tikfout in het adres. Alles staat
          tegenwoordig op één pagina.
        </p>
        <a href="/" class="btn-primary">Naar de homepage</a>
      </div>
    </section>
  </main>

  <Footer email={contact.email} />
</BaseLayout>

<style>
  .niet-gevonden {
    padding: 8rem 0 10rem;
  }

  .code {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 440px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    background: var(--text);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .btn-primary:hover {
    background: var(--color-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1.5px var(--text);
  }

  @media (max-width: 640px) {
    .niet-gevonden {
      padding: 4rem 0 6rem;
    }
  }
</style>
