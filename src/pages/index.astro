---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';

const page = await getEntry('pages', 'home');
const { meta, hero, problem, offer, why, reviews, contact } = page.data;

// Foto's staan in src/assets zodat Astro ze schaalt en naar WebP omzet.
// In home.md staat alleen de bestandsnaam, bijvoorbeeld "/joost.jpg".
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const beeld = (pad: string) => {
  const sleutel = `/src/assets/${pad.replace(/^\//, '')}`;
  const bestand = assets[sleutel];
  if (!bestand) {
    const beschikbaar = Object.keys(assets).map((k) => k.replace('/src/assets/', ''));
    throw new Error(
      `Afbeelding "${pad}" bestaat niet in src/assets/.\n` +
        `Beschikbaar: ${beschikbaar.join(', ') || '(map is leeg)'}\n` +
        `Pas de bestandsnaam aan in src/content/pages/home.md.`
    );
  }
  return bestand.default;
};
---

<BaseLayout title={meta.title} description={meta.description}>
  <Nav />

  <main>

    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <div class="hero-text">
            <p class="eyebrow">{hero.eyebrow}</p>
            <h1 set:html={hero.h1.replace('\n', '<br />')} />
            <p class="lead">{hero.lead}</p>
            <div class="hero-cta">
              <a href="#contact" class="btn-primary">{hero.cta_primary}</a>
              <a href="#aanbod" class="btn-ghost">{hero.cta_secondary}</a>
            </div>
          </div>
          <div class="hero-image">
            <Image
              src={beeld(hero.image)}
              alt="Joost Marsman – Chief Story"
              width={1000}
              height={1000}
              widths={[500, 1000]}
              sizes="(max-width: 768px) 92vw, 500px"
              format="webp"
              quality={80}
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Probleem -->
    <section class="section-problem">
      <div class="container">
        <div class="problem-grid">
          <div class="problem-text">
            <h2 set:html={problem.heading.replace('\n', '<br />')} />
            {problem.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="quote-slider" id="quoteSlider">
            <div class="quote-viewport">
              <div class="quote-track">
                {problem.quotes.map((q, i) => (
                  <blockquote class="quote-slide" data-index={i}>
                    <span class="quote-open">"</span>
                    <span class="quote-text">{q}</span>
                  </blockquote>
                ))}
              </div>
            </div>
            <div class="quote-dots">
              {problem.quotes.map((_, i) => (
                <button class={`quote-dot${i === 0 ? ' is-active' : ''}`} data-index={i} aria-label={`Quote ${i + 1}`} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Reviews: één zin per klant; de volledige teksten staan op /reviews -->
    <section class="section-reviews" id="reviews">
      <div class="container">
        <div class="section-header">
          <h2>{reviews.heading}</h2>
        </div>
        <div class="reviews-grid">
          {reviews.items.map((r) => (
            <figure class="review">
              <blockquote>
                <span class="review-open" aria-hidden="true">"</span>
                <p>{r.highlight}</p>
              </blockquote>
              <figcaption>
                <span class="review-name">{r.name}</span>
                <span class="review-company">{r.company}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="reviews-more">
          <a href="/reviews" class="btn-ghost">{reviews.link_label} &rarr;</a>
        </p>
      </div>
    </section>

    <!-- Waarom Chief Story -->
    <section class="section-why">
      <div class="container">
        <div class="why-inner">
          <div class="why-image">
            <Image
              src={beeld(why.image)}
              alt="Joost Marsman – Chief Story"
              width={880}
              height={880}
              widths={[440, 880]}
              sizes="(max-width: 900px) 92vw, 440px"
              format="webp"
              quality={80}
              loading="lazy"
            />
          </div>
          <div class="why-text">
            <span class="label">{why.label}</span>
            <h2>{why.heading}</h2>
            {why.body.map((p) => <p>{p}</p>)}
            <a
              href={why.linkedin}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Joost Marsman op LinkedIn"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Aanbod -->
    <section class="section-offer" id="aanbod">
      <div class="container">
        <div class="section-header">
          <h2>{offer.heading}</h2>
        </div>
        <div class="offer-grid">
          {offer.cards.map((card) => (
            <div class="offer-card">
              <div class="offer-badge">{card.duration}</div>
              <div class="offer-header">
                <h3>{card.title}</h3>
              </div>
              <p>{card.description}</p>
              <ul class="deliverables">
                {card.deliverables.map((d: string) => <li>{d}</li>)}
              </ul>
              <div class="offer-footer">
                <span class="price">{card.price}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact contact={contact} />

  </main>

  <Footer email={contact.email} />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 4rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 500px;
    gap: 4rem;
    align-items: center;
  }

  .hero-text {
    max-width: 600px;
  }

  .hero-image {
    position: relative;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(3.75rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: 1.5rem;
  }

  .lead {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    background: var(--text);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .btn-primary:hover {
    background: var(--color-2);
    color: var(--text);
    box-shadow: inset 0 0 0 1.5px var(--text);
  }

  .btn-primary.btn-large {
    font-size: 1.05rem;
    padding: 0.9rem 2rem;
  }

  .btn-ghost {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.75rem 0;
    border-bottom: 1px solid currentColor;
    transition: color 0.15s;
  }

  .btn-ghost:hover {
    color: var(--text);
  }

  /* Section basics */
  .section-header {
    margin-bottom: 2.25rem;
  }

  .label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-intro {
    max-width: 620px;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .section-header h2 {
    font-size: clamp(2.6rem, 4.5vw, 3.5rem);
  }

  .section-offer .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-offer .section-header::after {
    content: '';
    display: block;
    width: 88px;
    height: 3px;
    margin: 2rem auto 0;
    background: var(--accent);
  }

  .section-offer .section-header h2 {
    font-size: clamp(2.9rem, 5.5vw, 4.25rem);
  }

  /* Probleem */
  .section-problem {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-1);
  }

  .problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .problem-text h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1.5rem;
  }

  .problem-text p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .problem-quotes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quote-slider {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    /* Zonder dit duwt de quote-track (alle slides naast elkaar) de
       rechterkolom breder en drukt hij de tekstkolom plat. */
    min-width: 0;
  }

  .quote-viewport {
    overflow: hidden;
  }

  .quote-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .quote-slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .quote-open {
    display: block;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(4rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 0.75;
    color: var(--accent);
    margin-bottom: 0.5rem;
    font-variation-settings: 'opsz' 144;
  }

  .quote-text {
    display: block;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--text);
    font-variation-settings: 'opsz' 72;
  }

  .quote-dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }

  /* De knop is 24x24 zodat hij op een telefoon te raken is; het zichtbare
     bolletje blijft 6px en wordt als pseudo-element in het midden getekend. */
  .quote-dot {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
  }

  .quote-dot::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.2s, transform 0.2s;
  }

  .quote-dot.is-active::before {
    background: var(--text);
    transform: scale(1.4);
  }

  /* Aanbod */
  .section-offer {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-3);
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .offer-card {
    padding: 2rem;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    position: relative;
    background: #FFFFFF;
  }

  .offer-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 400;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    white-space: nowrap;
  }

  .offer-header {
    display: flex;
    justify-content: center;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .offer-header h3 {
    font-size: 1.45rem;
  }

  .offer-card > p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.65;
    text-align: center;
  }

  .deliverables {
    list-style: none;
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .deliverables li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .deliverables li::before {
    content: '\2192';
    color: var(--text-secondary);
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .offer-footer {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .price {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 400;
  }

  /* Waarom */
  .section-why {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-1);
  }

  .why-inner {
    display: grid;
    grid-template-columns: 440px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .why-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .why-text h2 {
    font-size: clamp(2.25rem, 3.2vw, 2.75rem);
    margin-bottom: 1.25rem;
  }

  .why-text p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .social-link {
    display: inline-flex;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--accent);
  }

  /* Reviews */
  .section-reviews {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-3);
  }

  .section-reviews .section-header {
    text-align: center;
  }

  .section-reviews .section-header::after {
    content: '';
    display: block;
    width: 88px;
    height: 3px;
    margin: 2rem auto 0;
    background: var(--accent);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .review {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: #FFFFFF;
    border: 1.5px solid var(--border);
    border-radius: 12px;
  }

  .review blockquote {
    flex: 1;
  }

  /* Zelfde aanhalingsteken als in de quote-slider, een maat kleiner. */
  .review-open {
    display: block;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 0.75;
    color: var(--accent);
    margin-bottom: 0.5rem;
    font-variation-settings: 'opsz' 144;
  }

  .review blockquote p {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.45;
    color: var(--text);
    font-variation-settings: 'opsz' 72;
  }

  .review figcaption {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .review-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .review-company {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .reviews-more {
    text-align: center;
    margin-top: 2.5rem;
  }

  .reviews-more .btn-ghost {
    display: inline-block;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .problem-grid,
    .why-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    /* Hoort bij de rest: op een tablet in portret bleef de tekstkolom
       anders naast een foto van 500px staan en werd hij onleesbaar smal. */
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .offer-grid,
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero-image img {
      width: 100%;
      height: auto;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 0 2.5rem;
    }

    .section-problem,
    .section-offer,
    .section-why,
    .section-reviews {
      padding: 3rem 0;
    }

    /* Op een telefoon lezen de maten van een groot scherm te klein.
       De koppen schalen al mee; de lopende tekst niet, dus die hier. */
    .section-intro,
    .why-text p {
      font-size: 1.05rem;
    }

    .offer-card > p,
    .deliverables li,
    .btn-primary,
    .btn-ghost {
      font-size: 1rem;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.quote-track');
  const dots = document.querySelectorAll<HTMLButtonElement>('.quote-dot');
  const total = dots.length;
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    current = index;
    track!.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
  }

  function startTimer() {
    timer = setInterval(() => goTo((current + 1) % total), 4000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      goTo(i);
      startTimer();
    });
  });

  startTimer();
</script>
