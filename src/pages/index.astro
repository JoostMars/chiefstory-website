---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';

const page = await getEntry('pages', 'home');
const { hero, problem, method, offer, why, contact } = page.data;

// Foto's staan in src/assets zodat Astro ze schaalt en naar WebP omzet.
// In home.md staat alleen de bestandsnaam, bijvoorbeeld "/joost.jpg".
const assets = import.meta.glob('/src/assets/*.{jpg,jpeg,png}', { eager: true });
const beeld = (pad: string) => (assets[`/src/assets/${pad.replace(/^\//, '')}`] as any).default;
---

<BaseLayout title="Van ruis naar signaal">
  <Nav />

  <main>

    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <div class="hero-text">
            <p class="eyebrow">{hero.eyebrow}</p>
            <h1 set:html={hero.h1.replace('\n', '<br />')} />
            <p class="lead">{hero.lead}</p>
            <div class="hero-cta">
              <a href="#contact" class="btn-primary">{hero.cta_primary}</a>
              <a href="#aanbod" class="btn-ghost">{hero.cta_secondary}</a>
            </div>
          </div>
          <div class="hero-image">
            <Image
              src={beeld(hero.image)}
              alt="Joost Marsman – Chief Story"
              width={1000}
              height={1000}
              widths={[500, 1000]}
              sizes="(max-width: 768px) 92vw, 500px"
              format="webp"
              quality={80}
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Probleem -->
    <section class="section-problem">
      <div class="container">
        <div class="problem-grid">
          <div class="problem-text">
            <h2 set:html={problem.heading.replace('\n', '<br />')} />
            {problem.body.map((p) => <p>{p}</p>)}
            <p class="signal-line">{problem.signal_line}<br /><strong>{problem.signal_emphasis}</strong></p>
          </div>
          <div class="quote-slider" id="quoteSlider">
            <div class="quote-viewport">
              <div class="quote-track">
                {problem.quotes.map((q, i) => (
                  <blockquote class="quote-slide" data-index={i}>
                    <span class="quote-open">"</span>
                    <span class="quote-text">{q}</span>
                  </blockquote>
                ))}
              </div>
            </div>
            <div class="quote-dots">
              {problem.quotes.map((_, i) => (
                <button class={`quote-dot${i === 0 ? ' is-active' : ''}`} data-index={i} aria-label={`Quote ${i + 1}`} />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Methode -->
    <section class="section-method">
      <div class="container">
        <div class="section-header">
          <h2>{method.heading}</h2>
          <p class="section-intro">{method.intro}</p>
        </div>
        <div class="steps">
          {method.steps.map((step) => (
            <div class="step">
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Waarom Chief Story -->
    <section class="section-why">
      <div class="container">
        <div class="why-inner">
          <div class="why-image">
            <Image
              src={beeld(why.image)}
              alt="Joost Marsman – Chief Story"
              width={880}
              height={880}
              widths={[440, 880]}
              sizes="(max-width: 900px) 92vw, 440px"
              format="webp"
              quality={80}
              loading="lazy"
            />
          </div>
          <div class="why-text">
            <span class="label">{why.label}</span>
            <h2>{why.heading}</h2>
            {why.body.map((p) => <p>{p}</p>)}
            <a
              href={why.linkedin}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Joost Marsman op LinkedIn"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Aanbod -->
    <section class="section-offer" id="aanbod">
      <div class="container">
        <div class="section-header">
          <h2>{offer.heading}</h2>
        </div>
        <div class="offer-grid">
          {offer.cards.map((card) => (
            <div class="offer-card">
              <div class="offer-badge">{card.duration}</div>
              <div class="offer-header">
                <h3>{card.title}</h3>
              </div>
              <p>{card.description}</p>
              <ul class="deliverables">
                {card.deliverables.map((d: string) => <li>{d}</li>)}
              </ul>
              <div class="offer-footer">
                <span class="price">{card.price}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section-contact" id="contact">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-text">
            <span class="label">{contact.label}</span>
            <h2>{contact.heading}</h2>
            <p class="lead">{contact.lead}</p>
            <a href={`mailto:${contact.email}`} class="contact-link">{contact.email}</a>
          </div>
          <div class="form-wrapper">
            <form id="signal-form" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value="b2eb9a05-3e76-42f7-89a8-251af95ae3f8" />
              <input type="hidden" name="subject" value="Nieuwe call aanvraag" />
              <input type="hidden" name="from_name" value="Chief Story Website" />
              <input type="checkbox" name="botcheck" style="display:none" />

              <div class="form-row">
                <div class="field">
                  <label for="naam">Naam</label>
                  <input type="text" id="naam" name="naam" required placeholder="Joost Marsman" />
                </div>
                <div class="field">
                  <label for="organisatie">Organisatie</label>
                  <input type="text" id="organisatie" name="organisatie" required placeholder="Chief Story" />
                </div>
              </div>

              <div class="field">
                <label for="email">E-mailadres</label>
                <input type="email" id="email" name="email" required placeholder="joost@example.com" />
              </div>

              <div class="field">
                <label for="ruis">Wat voelt nu als ruis?</label>
                <textarea id="ruis" name="ruis" rows="4" placeholder="Beschrijf in een paar zinnen waar het schuurt." required></textarea>
              </div>

              <button type="submit" class="btn-submit">Verstuur aanvraag</button>
              <div id="form-result" class="form-result" aria-live="polite"></div>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 6rem 0 5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 500px;
    gap: 4rem;
    align-items: center;
  }

  .hero-text {
    max-width: 600px;
  }

  .hero-image {
    position: relative;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .eyebrow {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .lead {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    background: var(--text);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    transition: opacity 0.15s;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-primary.btn-large {
    font-size: 1.05rem;
    padding: 0.9rem 2rem;
  }

  .btn-ghost {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.75rem 0;
    border-bottom: 1px solid currentColor;
    transition: color 0.15s;
  }

  .btn-ghost:hover {
    color: var(--text);
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.7rem 1.4rem;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.15s, background 0.15s;
  }

  .btn-outline:hover {
    border-color: var(--text);
    background: var(--surface);
  }

  /* Section basics */
  .section-header {
    margin-bottom: 3rem;
  }

  .section-intro {
    max-width: 620px;
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .section-offer .section-header {
    text-align: center;
  }

  .section-offer .section-header h2 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
  }

  /* Probleem */
  .section-problem {
    padding: 6rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-1);
  }

  .problem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .problem-text h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1.5rem;
  }

  .problem-text p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .signal-line {
    color: var(--text) !important;
    font-size: 1.05rem;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin-top: 1.5rem;
  }

  .problem-quotes {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quote-slider {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .quote-viewport {
    overflow: hidden;
  }

  .quote-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .quote-slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .quote-open {
    display: block;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(4rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 0.75;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    font-variation-settings: 'opsz' 144;
  }

  .quote-text {
    display: block;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--text);
    font-variation-settings: 'opsz' 72;
  }

  .quote-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .quote-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    background: var(--border);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .quote-dot.is-active {
    background: var(--text);
    transform: scale(1.4);
  }

  /* Methode */
  .section-method {
    padding: 6rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-3);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .step {
    padding: 2rem;
    background: #FFFFFF;
    border: 1.5px solid var(--border);
    border-radius: 12px;
  }

  .step-number {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 1rem;
  }

  .step h3 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }

  .step p:last-child {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Aanbod */
  .section-offer {
    padding: 6rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-3);
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .offer-card {
    padding: 2rem;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    position: relative;
    background: #FFFFFF;
  }

  .offer-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    white-space: nowrap;
  }

  .offer-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .offer-header h3 {
    font-size: 1.25rem;
  }

  .offer-card > p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.65;
  }

  .deliverables {
    list-style: none;
    flex: 1;
    margin-bottom: 1.5rem;
  }

  .deliverables li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .deliverables li::before {
    content: '\2192';
    color: var(--text-secondary);
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .offer-footer {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .price {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
  }

  /* Waarom */
  .section-why {
    padding: 6rem 0;
    border-bottom: 1px solid var(--border);
    background: var(--color-1);
  }

  .why-inner {
    display: grid;
    grid-template-columns: 440px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .why-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .why-text .label {
    margin-bottom: 0.75rem;
  }

  .why-text h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1.25rem;
  }

  .why-text p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .social-link {
    display: inline-flex;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--accent);
  }

  /* Contact */
  .section-contact {
    padding: 6rem 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-text .label {
    margin-bottom: 0.75rem;
  }

  .contact-text h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 1rem;
  }

  .contact-text .lead {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-link {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    border-bottom: 1.5px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }

  .contact-link:hover {
    border-color: var(--text);
  }

  .form-wrapper {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 2.5rem;
    border: 1px solid var(--border);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text);
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 0.65rem 0.9rem;
    transition: border-color 0.15s;
    outline: none;
    resize: vertical;
    width: 100%;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  input:focus,
  textarea:focus {
    border-color: var(--text);
  }

  .btn-submit {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    background: var(--text);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.875rem 1.5rem;
    cursor: pointer;
    transition: opacity 0.15s;
    margin-top: 0.25rem;
  }

  .btn-submit:hover {
    background: var(--accent);
    opacity: 1;
  }

  .form-result {
    margin-top: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .form-result--success { color: #2d6a2d; }
  .form-result--error { color: var(--accent); }

  /* Responsive */
  @media (max-width: 900px) {
    .problem-grid,
    .why-inner,
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .steps,
    .offer-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-image img {
      width: 100%;
      height: auto;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4rem 0 3.5rem;
    }

    .section-problem,
    .section-method,
    .section-offer,
    .section-why,
    .section-contact {
      padding: 4rem 0;
    }

    .form-wrapper {
      padding: 1.75rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.quote-track');
  const dots = document.querySelectorAll<HTMLButtonElement>('.quote-dot');
  const total = dots.length;
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    current = index;
    track!.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
  }

  function startTimer() {
    timer = setInterval(() => goTo((current + 1) % total), 4000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      goTo(i);
      startTimer();
    });
  });

  startTimer();
</script>

<script>
  const form = document.getElementById('signal-form') as HTMLFormElement;
  const result = document.getElementById('form-result') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Versturen...';

    const data = new FormData(form);
    const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
    const json = await res.json();

    if (json.success) {
      form.reset();
      result.textContent = 'Bedankt! Ik neem binnen één werkdag contact op.';
      result.className = 'form-result form-result--success';
    } else {
      result.textContent = 'Er ging iets mis. Stuur een mail naar joost@chiefstory.nl.';
      result.className = 'form-result form-result--error';
    }

    btn.disabled = false;
    btn.textContent = 'Verstuur aanvraag';
  });
</script>
