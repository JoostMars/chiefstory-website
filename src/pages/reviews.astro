---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import { getEntry } from 'astro:content';

// De volledige reviews. De copy staat in home.md onder `reviews`, naast de
// rest; de homepage toont daarvan alleen de highlight.
const page = await getEntry('pages', 'home');
const { reviews, contact } = page!.data;

// *woord* in de YAML wordt cursief. Meer markdown is er bewust niet.
const cursief = (tekst: string) => tekst.replace(/\*([^*]+)\*/g, '<em>$1</em>');
---

<BaseLayout title={reviews.page_heading} description={reviews.page_description}>
  <Nav />

  <main>
    <section class="reviews-page">
      <div class="container">
        <header class="page-header">
          <h1>{reviews.page_heading}</h1>
          <p class="lead">{reviews.page_lead}</p>
        </header>

        <div class="reviews">
          {reviews.items.map((r) => (
            <article class="review">
              <header>
                <span class="review-open" aria-hidden="true">"</span>
                <h2>{r.name}</h2>
                <p class="review-company">{r.company}</p>
              </header>
              <blockquote>
                {r.full.map((p) => <p set:html={cursief(p)} />)}
              </blockquote>
            </article>
          ))}
        </div>

      </div>
    </section>

    <Contact contact={contact} />
  </main>

  <Footer email={contact.email} />
</BaseLayout>

<style>
  .reviews-page {
    padding: 4rem 0;
  }

  .page-header {
    max-width: 640px;
    margin-bottom: 4rem;
  }

  h1 {
    font-size: clamp(2.6rem, 5vw, 3.75rem);
    font-weight: 400;
    margin-bottom: 1.25rem;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .reviews {
    display: flex;
    flex-direction: column;
  }

  /* Naam links, tekst rechts; op een telefoon onder elkaar. */
  .review {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3rem;
    padding: 3rem 0;
    border-top: 1px solid var(--border);
  }

  .review:last-child {
    border-bottom: 1px solid var(--border);
  }

  .review-open {
    display: block;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 0.75;
    color: var(--accent);
    margin-bottom: 0.75rem;
    font-variation-settings: 'opsz' 144;
  }

  .review h2 {
    font-size: 1.45rem;
    margin-bottom: 0.25rem;
  }

  .review-company {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  blockquote p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text);
    max-width: 640px;
    margin-bottom: 1.25rem;
  }

  blockquote p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .review {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .reviews-page {
      padding: 3rem 0 4rem;
    }

    .page-header {
      margin-bottom: 2.5rem;
    }

    .review {
      padding: 2.25rem 0;
    }
  }
</style>
