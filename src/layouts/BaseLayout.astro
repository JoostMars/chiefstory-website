---
import '../styles/tokens.css';
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Chief Story helpt groeiende organisaties hun strategische verhaal scherp te krijgen en werkend te maken in merk, marketing, sales en AI.' } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Eigen bestandsnaam: browsers bewaren een favicon hardnekkig, een nieuwe naam dwingt het nieuwe teken af. -->
    <link rel="icon" type="image/svg+xml" href="/chiefstory-teken.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=Inter+Tight:wght@600&display=swap" rel="stylesheet" />
    <title>{title} — Chief Story</title>
    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        /* Kleuren en letters komen uit brand/tokens.json (via src/styles/tokens.css).
           Deze namen blijven bestaan zodat de rest van de CSS niet hoeft te veranderen. */
        --color-1: var(--papier);
        --color-2: var(--papier);
        --color-3: var(--papier);
        --bg: var(--papier);
        --surface: var(--vlak);
        --border: var(--haarlijn);
        --text: var(--inkt);
        --text-secondary: var(--inkt-2);
        --accent: var(--wigrood);
        --accent-light: #F5EAE6;
        --font-heading: var(--font-serif);
        --font-body: var(--font-sans);
        --max-width: 1120px;
        --gutter: 2rem;
      }

      html {
        /* Ankerlinks (#aanbod, #contact) stoppen onder de sticky navigatie, niet erachter. */
        scroll-padding-top: 96px;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-body);
        /* Geen vaste pixelmaat: dan blijft de lettergrootte-instelling van de
           bezoeker werken. Alle rem-waarden schalen daarmee mee. */
        font-size: 100%;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        font-synthesis-weight: none;
      }

      body {
        min-height: 100vh;
      }

      h1, h2, h3, h4 {
        font-family: var(--font-heading);
        /* DM Serif Display heeft maar één snede (400). Vraag je om 600 of 700,
           dan verzint de browser het vet — Safari tekent de letters dan
           dubbel, wat als een schaduw oogt. */
        font-weight: 400;
        line-height: 1.06;
        letter-spacing: -0.02em;
        font-variation-settings: 'opsz' 72;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--gutter);
      }

      @media (max-width: 640px) {
        :root {
          --gutter: 1.25rem;
        }

        /* Op een telefoon leest 16px te klein. Alles is in rem, dus één
           basismaat hier schaalt koppen, tekst, knoppen en labels mee. */
        html {
          font-size: 118.75%;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
